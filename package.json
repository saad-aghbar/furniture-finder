{
  "name": "furniture-finder",
  "productName": "Furniture Finder",
  "version": "1.0.2",
  "description": "Floating multilingual Excel search bar for Windows",
  "main": "./out/main/index.js",
  "author": "Furniture Finder",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://github.com/saad-aghbar/furniture-finder",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node scripts/run-electron-node.mjs ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node scripts/run-electron-node.mjs ./node_modules/vitest/vitest.mjs",
    "test:e2e": "electron-vite build && playwright test",
    "lint": "eslint . && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "format": "prettier --write .",
    "fixtures": "node scripts/run-electron-node.mjs ./node_modules/tsx/dist/cli.mjs scripts/make-fixtures.ts",
    "icons": "node scripts/make-icons.mjs",
    "dist:win": "electron-vite build && electron-builder --win nsis --x64",
    "dist:mac": "electron-vite build && electron-builder --mac dir",
    "postinstall": "electron-builder install-app-deps",
    "test:perf": "node scripts/run-electron-node.mjs ./node_modules/vitest/vitest.mjs run -c vitest.perf.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chokidar": "^5.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-store": "^12.0.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
